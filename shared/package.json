{
  "name": "@solanaideaslab/shared",
  "version": "0.1.0",
  "description": "Canonical shared auth + API middleware for SolanaIdeasLab bots (real Ed25519 + HS256 JWT; no external crypto deps).",
  "private": true,
  "main": "dist/auth/wallet-auth.js",
  "types": "dist/auth/wallet-auth.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest --rootDir .",
    "lint": "eslint . --ext .ts",
    "security-check": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@solana/web3.js": "^3.2.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "express-rate-limit": "^8.7.5",
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tweetnacl": "^1.0.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "stream-json": ">=3.5.0",
    "qs": "6.16.1"
  }
}
