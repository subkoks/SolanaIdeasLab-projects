{
  "name": "@solanaideaslab/shared",
  "version": "0.1.0",
  "description": "Canonical shared auth + API middleware for SolanaIdeasLab bots (real Ed25519 + HS256 JWT; no external crypto deps).",
  "private": true,
  "main": "dist/auth/wallet-auth.js",
  "types": "dist/auth/wallet-auth.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest --rootDir .",
    "lint": "eslint . --ext .ts",
    "security-check": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "express-rate-limit": "^8.6.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tweetnacl": "^1.0.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "9.0.1"
  }
}
